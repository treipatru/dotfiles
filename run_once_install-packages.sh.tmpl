{{ if eq .chezmoi.osRelease.id "fedora" -}}
#!/bin/sh

# Speed up dnf
printf ">>> Checking dnf for speed improvements\n"
if ! grep -q -F "max_parallel_downloads" "/etc/dnf/dnf.conf"; then
    printf "  * Increase max parallel downloads\n"
    printf "max_parallel_downloads=15\n" | sudo tee -a /etc/dnf/dnf.conf
fi

if ! grep -q -F "fastestMirror" "/etc/dnf/dnf.conf"; then
    printf "  * Choose fastest mirror\n"
    printf "fastestMirror=true\n" | sudo tee -a /etc/dnf/dnf.conf
fi

# Upgrade
printf "\n>>> Upgrading system packages\n"
sudo dnf --assumeyes upgrade

# Install packages
printf "\n>>> Installing packages\n"
sudo dnf install --assumeyes \
    @development-tools \
    dnf-plugins-core \
    bat \
    btop \
    curl \
    eza \
    fd-find \
    file-roller \
    flatpak \
    flameshot \
    fzf \
    gcc \
    gcc-c++ \
    git \
    git-delta \
    google-noto-emoji-fonts \
    kernel-devel \
    kernel-headers \
    meld \
    neovim \
    nmap \
    nnn \
    openssl \
    openssl-devel \
    python3 \
    ripgrep \
    tldr \
    tmux \
    zsh \
    zoxide

# Ghostty isn't in the Fedora repos, install it from the community COPR
printf "\n>>> Installing ghostty\n"
sudo dnf copr enable --assumeyes scottames/ghostty
sudo dnf install --assumeyes ghostty

# Zsh plugin manager, sourced from ~/.antidote by .zshrc
if [ -d ~/.antidote ]; then
    printf "\n>>> Antidote is already installed, skipping.\n"
else
    printf "\n>>> Installing antidote\n"
    git clone --depth=1 https://github.com/mattmc3/antidote.git ~/.antidote
fi

# Install rust
if command -v rustc &> /dev/null; then
    printf "\n>>> Rust is already installed, skipping.\n"
else
    printf "\n>>> Installing rust\n"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

source ~/.cargo/env

# Install rust packages
printf "\n>>> Installing cargo packages\n"

# Updated for cargo binaries
cargo install cargo-update
# Job manager
cargo install --locked pueue
# Node version manager
cargo install fnm
# Terminal prompt
cargo install starship --locked
# Shell history
cargo install atuin
# Builds treesitter parsers for neovim
cargo install --locked tree-sitter-cli

printf "\n>>> Installing latest node \n"
fnm install --latest


{{ else if eq .chezmoi.osRelease.id "manjaro" -}}
#!/bin/sh
echo manjaro

{{ end -}}
